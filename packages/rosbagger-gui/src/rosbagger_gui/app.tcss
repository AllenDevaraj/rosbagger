/* rosbagger-gui shell layout (D-01) + disabled-live dim styling (D-03).
   The App is a Horizontal of a fixed-width sidebar ListView and a flexing
   ContentSwitcher; disabled (ROS-absent) live nav items + panels render dim. */

Horizontal {
    height: 1fr;
}

#sidebar {
    width: 24;
    border-right: solid $primary;
}

#content {
    width: 1fr;
    padding: 1 2;
}

/* Capability gate (D-03): a disabled live nav item / panel reads as dim so the
   teaching hint is visibly inert rather than clickable. */
ListItem:disabled {
    color: $text-disabled;
}

#content > :disabled {
    color: $text-disabled;
}

/* Replay scrubber (Plan 14-06, D-09): a one-row timeline bar spanning the panel
   width. The bar glyphs render dim ($primary), the playhead/markers pop via the
   widget's glyphs; height is a single line so it reads as a transport track. */
Scrubber {
    height: 1;
    width: 1fr;
    color: $primary;
}

/* Replay transport row: the play/pause/step buttons + rate input + loop switch sit
   in a compact horizontal strip above/below the scrubber. */
.replay-controls {
    height: auto;
}

/* Fix the Phase-14 blank-panel regression (GUI-01): InspectPanel and TfPanel extend a
   bare textual.widget.Widget with no intrinsic height, so Textual lays them out at
   height 0 and their populated DataTables render invisible. QueryPanel renders only
   because it extends Vertical, which flexes inside the `Horizontal { height: 1fr }`
   shell. Give the two bare-Widget panels a fill height (mirroring the type-selector
   `Scrubber` rule above) so they fill the ContentSwitcher instead of collapsing. */
InspectPanel,
TfPanel {
    height: 1fr;
    width: 1fr;
}

/* The two panels each stack a Static header + two DataTables. A bare `height: 1fr` on
   the panel leaves the tables at their default `height: auto` (content-sized); give the
   panels' DataTables a flexing share so #bag-info/#table-schemas and #tf-edges/#tf-gaps
   are both visible. Descendant selector (scoped to these two panels only) so the Static
   header stays auto-height and the working QueryPanel layout is untouched. */
InspectPanel DataTable,
TfPanel DataTable {
    height: 1fr;
}
